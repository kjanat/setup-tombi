{
	"name": "setup-tombi",
	"version": "1.7.3",
	"private": true,
	"description": "GitHub Action to set up Tombi",
	"keywords": [
		"github",
		"actions",
		"tombi",
		"toml",
		"setup"
	],
	"license": "MIT",
	"author": "tombi-toml",
	"type": "module",
	"imports": {
		"#*": "./src/*.ts",
		"#pkg": "./package.json"
	},
	"main": "dist/index.mjs",
	"scripts": {
		"build": "run -p --runtime node typecheck tsdown",
		"format": "biome format --write",
		"format-check": "biome format",
		"lint": "biome lint --write",
		"lint-check": "biome lint",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@actions/cache": "^6.3.0",
		"@actions/core": "^3.0.1",
		"@actions/tool-cache": "^4.0.0",
		"@biomejs/biome": "2.5.15",
		"@types/node": ">=24 <25",
		"cross-env": "^10.1.0",
		"runner-run": "^0.27.1",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.9.1"
		},
		"runtime": {
			"name": "node",
			"version": "24"
		}
	}
}
